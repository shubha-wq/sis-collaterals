# Creative Library (shared, team-accessible). Copy to .env.local for local
# development, and set the same two variables in Vercel / Netlify.
# Both values are in Supabase → Project Settings → API. The anon key is
# public by design; access is protected by row-level security (team members only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI background expansion for Website Banner / Listing (server-side only).
# NEVER prefix these with VITE_ — they must not reach the browser.
# See docs/AI_IMAGE_EXPANSION.md.
STABILITY_API_KEY=
# IMAGE_EXPANSION_PROVIDER=stability
# STABILITY_OUTPAINT_CREATIVITY=0.35

# Development only: try the flow without paid calls (striped "MOCK" stand-in).
# VITE_IMAGE_EXPANSION=mock
